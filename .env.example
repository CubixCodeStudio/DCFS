# DiscordFS server configuration.
#
# Copy to .env and fill in. The server reads the PROCESS ENVIRONMENT, not this
# file — export the variables yourself:
#
#   set -a; . ./.env; set +a; cargo run --bin discordfs-server
#
# Never commit a filled-in .env. If a real token, key or DSN ever lands in a
# commit, a log, a screenshot or a chat, treat it as leaked and rotate it.
# Empty values are treated as unset.

# --- Required: the server refuses to start without these -------------------

# Master key for chunk encryption: exactly 32 bytes, hex-encoded (64 chars).
# Losing it means losing every file; changing it makes existing files
# undecryptable, because v0.1 has no key rotation.
#   openssl rand -hex 32
MASTER_KEY=

# Shared bearer token every client must present. At least 16 characters.
#   openssl rand -hex 32
API_TOKEN=

# Directory holding encrypted chunks. Must survive restarts: the metadata
# store keeps pointing at chunks that live here. Not needed if the Discord
# webhook pair below is set.
OBJECT_STORE_PATH=./data/objects

# Extra webhooks, as id:token separated by commas. Each one is rate limited on
# its own, so several of them raise the ceiling on concurrent uploads. A file
# always goes to exactly one of them. The pair above is the first entry, so
# setting only this is fine too.
#   DISCORD_WEBHOOKS=111:tokenA,222:tokenB
DISCORD_WEBHOOKS=

# --- Read and used today ---------------------------------------------------

# PostgreSQL connection string. Unset selects the in-memory repository, which
# is for development only: all metadata is lost on restart.
#
# This can be a database you already have: DiscordFS never creates a database,
# confines itself to DATABASE_SCHEMA, and its migration is additive and
# idempotent (no DROP, ALTER, TRUNCATE or DELETE). Use a role that can only
# reach that schema.
DATABASE_URL=postgresql://user:password@localhost:5432/discordfs

# Schema DiscordFS keeps its tables in. Default "public"; set a dedicated
# one when sharing a database with another application.
DATABASE_SCHEMA=discordfs

# Install the schema at startup if it is missing. Off by default, because the
# target may be someone else's database — apply
# migrations/0001_initial.sql yourself, or set this to true.
DATABASE_AUTO_MIGRATE=false

# Server bind address. Default 127.0.0.1:8080. The bearer token is the only
# thing protecting this port, and there is no TLS — put it behind a reverse
# proxy before exposing it beyond localhost.
SERVER_ADDR=127.0.0.1:8080

# Part size in bytes for new files. Default 16777216 (16 MiB). Existing files
# keep the part size they were written with. A file larger than this is split
# into parts, each encrypted and stored separately, and a read only fetches the
# parts it covers.
#
# Measured against a plain Discord webhook: 20 MiB was accepted, 22 MiB came
# back as "40005 Request entity too large". Bigger parts mean fewer attachments
# and fewer requests per file; smaller parts mean a smaller read-modify-write
# when a few bytes change.
CHUNK_SIZE=16777216

# Largest object the storage backend accepts, if it has a limit. A sealed part
# is CHUNK_SIZE + 40 bytes (24-byte nonce + 16-byte tag) and the server refuses
# to start if that does not fit. Unset means no limit is enforced.
#
# Discord's per-attachment limit depends on the server's boost tier and on
# Discord's current policy, so set this to what your backend actually accepts
# rather than trusting a number written here.
# MAX_ATTACHMENT_BYTES=20971520

# Log filter: trace, debug, info, warn, error. Default info.
# RUST_LOG=debug makes SQLx log every statement (no bound values).
RUST_LOG=info

# --- Discord backend -------------------------------------------------------
# Set both and chunks go to Discord instead of OBJECT_STORE_PATH. The client
# posts attachments as a WEBHOOK, so these are webhook credentials, not a bot
# token. Create one in a channel's Integrations settings; the URL looks like
# https://discord.com/api/webhooks/<id>/<token>.
#
# Locators are stored in PostgreSQL, so a restart can still find what was
# uploaded. Not verified against live Discord — see the README.

DISCORD_WEBHOOK_ID=
DISCORD_WEBHOOK_TOKEN=

# How long a deleted or superseded version's objects are kept before the
# background sweep deletes them from the storage backend, in seconds.
# Deleting a file frees space only after this window.
GC_RETENTION_SECS=3600

# --- Client ----------------------------------------------------------------
# Read by discordfs-fuse. The token is read from the environment and never
# from the command line, where `ps` would show it.

# DISCORDFS_SERVER=http://127.0.0.1:8080
# DISCORDFS_TOKEN=

# stream (default) keeps a bounded local cache; mirror keeps a full local copy
# and prefetches the whole tree after mount.
# DISCORDFS_MODE=stream
# DISCORDFS_CACHE_SIZE=1073741824

# Where cached file contents live. These blocks are PLAINTEXT, so point this at
# a directory only you can read. Default: a per-process directory under $TMPDIR,
# removed on unmount.
# DISCORDFS_CACHE_DIR=

# --- Tests only ------------------------------------------------------------

# Enables the PostgreSQL repository and end-to-end suites. Point this at a
# THROWAWAY database: each test creates and drops its own schema.
#   docker run -d --rm -e POSTGRES_PASSWORD=dev -p 55432:5432 --name dfs-pg postgres:16
# TEST_DATABASE_URL=postgresql://postgres:dev@localhost:55432/postgres
