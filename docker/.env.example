# Copy to .env beside this file. Both are gitignored.
#
#   { echo "MASTER_KEY=$(openssl rand -hex 32)"
#     echo "API_TOKEN=$(openssl rand -hex 32)"; } > .env

# Decrypts every chunk ever written. Losing it loses the data: v0.1 has no key
# rotation. Back it up somewhere that is not the database's disk.
MASTER_KEY=

# What clients present to the API.
API_TOKEN=

# Leave empty to keep chunks in the local volume. Set them to store chunks as
# Discord attachments instead. DISCORD_WEBHOOKS takes id:token pairs separated
# by commas, for more than one; a file always goes to one of them whole.
DISCORD_WEBHOOK_ID=
DISCORD_WEBHOOK_TOKEN=
DISCORD_WEBHOOKS=

RUST_LOG=info
